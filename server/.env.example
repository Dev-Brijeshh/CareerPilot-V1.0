# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas or local, e.g. mongodb://127.0.0.1:27017/careerpilot)
MONGODB_URI=

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# CORS - comma-separated list of allowed frontend origins.
# Leave blank in development to allow all origins.
CLIENT_URL=http://localhost:5173

# Groq (OpenAI-compatible) API key used for all AI features
# (resume analysis, roadmap generation, mock interviews).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
